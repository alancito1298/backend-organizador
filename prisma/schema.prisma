generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Docente {
  id              Int             @id @default(autoincrement())
  nombre          String
  apellido        String
  email           String          @unique
  password        String
  telefono        String?
  proveedorAuth   String?
  creadoEn        DateTime        @default(now())
  existe          Boolean         @default(true)
  provincia       String?
  localidad       String?
  fechaNacimiento String?
  agenda          Agenda[]
  bibliografia    Bibliografia[]
  cursos          Curso[]
  HistorialPlan   HistorialPlan[]
  horarios        Horario[]
  suscripcion     Suscripcion?
}

model Curso {
  id              Int             @id @default(autoincrement())
  escuela         String
  anio            String
  materia         String
  existe          Boolean         @default(true)
  docenteId       Int
  alumnos         AlumnoCurso[]
  docente         Docente         @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  documentos      Documento[]
  planificaciones Planificacion[]
}

model Alumno {
  id       Int           @id @default(autoincrement())
  nombre   String
  apellido String
  dni      String?
  contacto String?
  cursos   AlumnoCurso[]
}

model AlumnoCurso {
  id          Int            @id @default(autoincrement())
  alumnoId    Int
  cursoId     Int
  alumno      Alumno         @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  curso       Curso          @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  asistencias Asistencia[]
  notas       Calificacion[]

  @@unique([alumnoId, cursoId])
}

model Asistencia {
  id            Int              @id @default(autoincrement())
  fecha         DateTime
  estado        EstadoAsistencia
  alumnoCursoId Int
  alumnoCurso   AlumnoCurso      @relation(fields: [alumnoCursoId], references: [id], onDelete: Cascade)

  @@unique([fecha, alumnoCursoId])
}

model Calificacion {
  id            Int            @id @default(autoincrement())
  valor         Float
  fecha         DateTime
  trimestre     Int
  tipo          TipoEvaluacion
  alumnoCursoId Int
  alumnoCurso   AlumnoCurso    @relation(fields: [alumnoCursoId], references: [id], onDelete: Cascade)
}

model Agenda {
  id          Int      @id @default(autoincrement())
  fecha       DateTime
  descripcion String
  docenteId   Int
  docente     Docente  @relation(fields: [docenteId], references: [id], onDelete: Cascade)
}

model Planificacion {
  id      Int       @id @default(autoincrement())
  tema    String
  link    String
  fecha   DateTime?
  cursoId Int
  curso   Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
}

model Documento {
  id      Int           @id @default(autoincrement())
  nombre  String
  tipo    TipoDocumento
  link    String
  cursoId Int
  curso   Curso         @relation(fields: [cursoId], references: [id], onDelete: Cascade)
}

model Bibliografia {
  id        Int     @id @default(autoincrement())
  tema      String
  link      String
  docenteId Int
  docente   Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade)
}

model Horario {
  id          Int       @id @default(autoincrement())
  dia         DiaSemana
  hora        String
  descripcion String?
  docenteId   Int
  docente     Docente   @relation(fields: [docenteId], references: [id], onDelete: Cascade)
}

model Plan {
  id                                               Int             @id @default(autoincrement())
  nombre                                           String
  precio                                           Int
  maxcursos                                        Int
  activo                                           Boolean?        @default(true)
  maxAlumnos                                       Int?            @default(200)
  maxBibliografia                                  Int?            @default(100)
  maxDocumentos                                    Int?            @default(50)
  HistorialPlan_HistorialPlan_planAnteriorIdToPlan HistorialPlan[] @relation("HistorialPlan_planAnteriorIdToPlan")
  HistorialPlan_HistorialPlan_planNuevoIdToPlan    HistorialPlan[] @relation("HistorialPlan_planNuevoIdToPlan")
  suscripciones                                    Suscripcion[]
}

model Suscripcion {
  id                     Int       @id @default(autoincrement())
  estado                 String
  proveedor              String
  fechaInicio            DateTime
  fechaFin               DateTime?
  docenteId              Int       @unique
  planId                 Int
  periodo                String?   @default("mensual")
  autoRenovacion         Boolean?  @default(true)
  actualizadoEn          DateTime? @default(now()) @db.Timestamp(6)
  externalSubscriptionId String?
  proveedorPago          String?
  diasTrial              Int?      @default(7)
  fechaTrialInicio       DateTime? @db.Timestamp(6)
  fechaTrialFin          DateTime? @db.Timestamp(6)
  pagos                  Pago[]
  docente                Docente   @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  plan                   Plan      @relation(fields: [planId], references: [id], onUpdate: NoAction)

  @@index([docenteId], map: "idx_suscripcion_docente")
  @@index([externalSubscriptionId], map: "idx_suscripcion_external")
}

model Pago {
  id            Int         @id @default(autoincrement())
  monto         Int
  estado        String
  metodo        String
  referencia    String?
  fecha         DateTime?   @default(now()) @db.Timestamp(6)
  suscripcionId Int
  suscripcion   Suscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model HistorialPlan {
  id                                      Int       @id @default(autoincrement())
  docenteId                               Int
  planAnteriorId                          Int?
  planNuevoId                             Int
  fechaCambio                             DateTime? @default(now()) @db.Timestamp(6)
  motivo                                  String?
  Docente                                 Docente   @relation(fields: [docenteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "HistorialPlan_docente_fkey")
  Plan_HistorialPlan_planAnteriorIdToPlan Plan?     @relation("HistorialPlan_planAnteriorIdToPlan", fields: [planAnteriorId], references: [id], onUpdate: NoAction, map: "HistorialPlan_planAnterior_fkey")
  Plan_HistorialPlan_planNuevoIdToPlan    Plan      @relation("HistorialPlan_planNuevoIdToPlan", fields: [planNuevoId], references: [id], onUpdate: NoAction, map: "HistorialPlan_planNuevo_fkey")

  @@index([docenteId], map: "idx_historial_docente")
  @@index([fechaCambio], map: "idx_historial_fecha")
}

enum EstadoAsistencia {
  presente_buen_concepto
  presente_mal_concepto
  ausente
  justificada
}

enum TipoDocumento {
  pdf
  docx
}

enum DiaSemana {
  Lunes
  Martes
  Miercoles
  Jueves
  Viernes
}

enum TipoEvaluacion {
  trabajo_practico
  Examen
  final
}

enum TipoNota {
  TP
  Examen
  Final
}
